<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DuckBridge" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Launch background, shown until the first frame. -->
        <item name="android:windowBackground">@drawable/duck_splash</item>
    </style>

    <style name="Widget.Duck.Button" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Duck.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Widget.Duck.Button.Text">
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
